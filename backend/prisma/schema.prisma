// Prisma schema for Neighbors-Kitchen

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  CHEF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PickupOrDelivery {
  PICKUP
  DELIVERY
}

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  DESSERT
  SNACK
}

// How a kitchen was placed on the map.
enum LocationPrecision {
  ADDRESS  // its street address was found
  ZIP_CODE // only the middle of its ZIP code
}

enum SuggestionStatus {
  PENDING
  CONSIDERING
  ACCEPTED
  DECLINED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  role                    UserRole  @default(CUSTOMER)
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  phone                   String?
  profilePhotoUrl         String?   @map("profile_photo_url")
  emailVerified           Boolean   @default(false) @map("email_verified")
  emailVerificationToken  String?   @map("email_verification_token")
  passwordResetToken      String?   @map("password_reset_token")
  passwordResetExpires    DateTime? @map("password_reset_expires")
  failedLoginAttempts     Int       @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime? @map("locked_until")
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  chefProfile             ChefProfile?
  ordersAsCustomer        Order[]      @relation("CustomerOrders")
  reviews                 Review[]
  suggestions             Suggestion[]
  suggestionVotes         SuggestionVote[]
  refreshTokens           RefreshToken[]

  @@map("users")
}

// Long-lived login sessions. Only a SHA-256 hash of each token is stored.
model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ChefProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  kitchenName             String?  @map("kitchen_name")
  bio                     String?  @db.Text
  specialties             String[]
  yearsExperience         Int?     @map("years_experience")
  certifications          String[]
  stripeConnectAccountId  String?  @map("stripe_connect_account_id")
  stripeOnboardingComplete Boolean @default(false) @map("stripe_onboarding_complete")
  addressLine1            String   @map("address_line1")
  addressLine2            String?  @map("address_line2")
  city                    String
  state                   String
  zipCode                 String   @map("zip_code")
  // Filled in by geocoding (Phase 7); never sent in public responses
  latitude                Decimal? @db.Decimal(10, 8)
  longitude               Decimal? @db.Decimal(11, 8)
  // Public area center: the location moved 0.1-0.3 miles in a random direction (services/geo.ts)
  approxLatitude          Decimal? @map("approx_latitude") @db.Decimal(9, 6)
  approxLongitude         Decimal? @map("approx_longitude") @db.Decimal(9, 6)
  // How the kitchen was placed; null when it is not on the map
  locationPrecision       LocationPrecision? @map("location_precision")
  serviceRadiusMiles      Decimal  @default(5.0) @map("service_radius_miles") @db.Decimal(5, 2)
  averageRating           Decimal? @map("average_rating") @db.Decimal(3, 2)
  totalReviews            Int      @default(0) @map("total_reviews")
  totalOrders             Int      @default(0) @map("total_orders")
  isAcceptingOrders       Boolean  @default(true) @map("is_accepting_orders")
  // How orders are fulfilled
  orderLeadTimeHours      Int      @default(24) @map("order_lead_time_hours")
  offersPickup            Boolean  @default(true) @map("offers_pickup")
  offersDelivery          Boolean  @default(false) @map("offers_delivery")
  deliveryFee             Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  timezone                String   @default("America/Los_Angeles")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  menus                   Menu[]
  meals                   Meal[]
  ordersAsChef            Order[]      @relation("ChefOrders")
  reviews                 Review[]
  suggestions             Suggestion[]
  availability            ChefAvailability[]

  @@index([userId])
  @@index([latitude, longitude])
  @@map("chef_profiles")
}

// Weekly hours when a chef has food ready for pickup or delivery, in the chef's local time.
model ChefAvailability {
  id          String   @id @default(uuid())
  chefId      String   @map("chef_id")
  dayOfWeek   Int      @map("day_of_week") // 0 = Sunday ... 6 = Saturday
  startTime   String   @map("start_time")  // "17:00"
  endTime     String   @map("end_time")    // "20:00"

  // Relations
  chef        ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)

  @@unique([chefId, dayOfWeek])
  @@map("chef_availability")
}

model Menu {
  id              String    @id @default(uuid())
  chefId          String    @map("chef_id")
  name            String
  description     String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  availableFrom   DateTime? @map("available_from")
  availableUntil  DateTime? @map("available_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  chef            ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)
  meals           Meal[]

  @@index([chefId])
  @@map("menus")
}

model Meal {
  id                String       @id @default(uuid())
  menuId            String       @map("menu_id")
  chefId            String       @map("chef_id")
  name              String
  description       String       @db.Text
  price             Decimal      @db.Decimal(10, 2)
  imageUrl          String?      @map("image_url")
  category          MealCategory
  cuisineType       String?      @map("cuisine_type")
  dietaryTags       String[]     @map("dietary_tags")
  servings          Int          @default(1)
  prepTimeMinutes   Int          @map("prep_time_minutes")
  isAvailable       Boolean      @default(true) @map("is_available")
  maxOrdersPerDay   Int?         @map("max_orders_per_day")
  averageRating     Decimal?     @map("average_rating") @db.Decimal(3, 2)
  totalReviews      Int          @default(0) @map("total_reviews")
  totalOrders       Int          @default(0) @map("total_orders")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  menu              Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  chef              ChefProfile  @relation(fields: [chefId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  reviews           Review[]

  @@index([chefId])
  @@index([category])
  @@map("meals")
}

model Order {
  id                  String            @id @default(uuid())
  orderNumber         String            @unique @map("order_number")
  customerId          String            @map("customer_id")
  chefId              String            @map("chef_id")
  status              OrderStatus       @default(PENDING)
  subtotal            Decimal           @db.Decimal(10, 2)
  deliveryFee         Decimal           @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  // The platform's commission, taken from the chef's payout (not added to the customer's total)
  platformFee         Decimal           @map("platform_fee") @db.Decimal(10, 2)
  // What the customer pays: subtotal + delivery fee
  total               Decimal           @db.Decimal(10, 2)
  paymentStatus       PaymentStatus     @default(PENDING) @map("payment_status")
  paymentIntentId     String?           @map("payment_intent_id")
  pickupOrDelivery    PickupOrDelivery  @map("pickup_or_delivery")
  scheduledFor        DateTime          @map("scheduled_for")
  deliveryAddress     String?           @map("delivery_address") @db.Text
  // Straight-line miles from the chef's area center to the delivery address, when it could be located
  deliveryDistanceMiles Decimal?        @map("delivery_distance_miles") @db.Decimal(5, 1)
  contactPhone        String?           @map("contact_phone")
  specialInstructions String?           @map("special_instructions") @db.Text
  customerNotes       String?           @map("customer_notes") @db.Text
  chefNotes           String?           @map("chef_notes") @db.Text
  cancellationReason  String?           @map("cancellation_reason") @db.Text
  cancelledAt         DateTime?         @map("cancelled_at")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  customer            User              @relation("CustomerOrders", fields: [customerId], references: [id])
  chef                ChefProfile       @relation("ChefOrders", fields: [chefId], references: [id])
  orderItems          OrderItem[]
  events              OrderEvent[]
  payment             Payment?
  reviews             Review[]

  @@index([customerId])
  @@index([chefId])
  @@index([status])
  @@index([chefId, scheduledFor])
  @@map("orders")
}

// Every status change on an order, for the tracking timeline and as an audit trail.
model OrderEvent {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  status      OrderStatus
  note        String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  mealId            String   @map("meal_id")
  // The meal's name when it was ordered, so order history stays accurate if the chef renames it
  mealName          String   @default("") @map("meal_name")
  quantity          Int
  priceAtPurchase   Decimal  @map("price_at_purchase") @db.Decimal(10, 2)
  specialRequests   String?  @map("special_requests") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meal              Meal     @relation(fields: [mealId], references: [id])

  @@map("order_items")
}

// One review per meal per completed order, written by the customer who ordered it.
model Review {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  mealId            String    @map("meal_id")
  chefId            String    @map("chef_id")
  customerId        String    @map("customer_id")
  rating            Int
  title             String?
  comment           String?   @db.Text
  images            String[]
  isVerifiedPurchase Boolean  @default(true) @map("is_verified_purchase")
  isFlagged         Boolean   @default(false) @map("is_flagged")
  flagReason        String?   @map("flag_reason") @db.Text
  chefResponse      String?   @map("chef_response") @db.Text
  chefRespondedAt   DateTime? @map("chef_responded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  order             Order       @relation(fields: [orderId], references: [id])
  meal              Meal        @relation(fields: [mealId], references: [id])
  chef              ChefProfile @relation(fields: [chefId], references: [id])
  customer          User        @relation(fields: [customerId], references: [id])

  @@unique([orderId, mealId])
  @@index([chefId])
  @@index([mealId])
  @@map("reviews")
}

model Suggestion {
  id                  String            @id @default(uuid())
  chefId              String            @map("chef_id")
  customerId          String            @map("customer_id")
  mealName            String            @map("meal_name")
  description         String            @db.Text
  dietaryRequirements String[]          @map("dietary_requirements")
  status              SuggestionStatus  @default(PENDING)
  chefResponse        String?           @map("chef_response") @db.Text
  priority            Priority          @default(MEDIUM)
  // Number of people who want this dish (kept in step with suggestion_votes)
  votes               Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  chef                ChefProfile       @relation(fields: [chefId], references: [id])
  customer            User              @relation(fields: [customerId], references: [id])
  voters              SuggestionVote[]

  @@index([chefId])
  @@map("suggestions")
}

// One row per person who wants a suggested dish, so nobody can vote twice.
model SuggestionVote {
  id            String     @id @default(uuid())
  suggestionId  String     @map("suggestion_id")
  userId        String     @map("user_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  // Relations
  suggestion    Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@map("suggestion_votes")
}

model Payment {
  id                      String        @id @default(uuid())
  orderId                 String        @unique @map("order_id")
  stripePaymentIntentId   String        @unique @map("stripe_payment_intent_id")
  amount                  Decimal       @db.Decimal(10, 2)
  platformFee             Decimal       @map("platform_fee") @db.Decimal(10, 2)
  chefPayout              Decimal       @map("chef_payout") @db.Decimal(10, 2)
  status                  PaymentStatus @default(PENDING)
  refundAmount            Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  refundReason            String?       @map("refund_reason") @db.Text
  payoutId                String?       @map("payout_id")
  paidOutAt               DateTime?     @map("paid_out_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  // Relations
  order                   Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}
