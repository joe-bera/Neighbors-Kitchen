# Copy this file to .env and adjust as needed.

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database - the local server started by `npm run db:start` (no password needed locally)
DATABASE_URL=postgresql://postgres@localhost:5433/neighbors_kitchen

# Authentication - use a long random value in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRE=15m
REFRESH_TOKEN_TTL_DAYS=7

# Rate limiting (max requests per window, per IP address)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Address lookups for the map (Phase 7): "census" uses the free US Census Bureau geocoder (no key needed), "off" skips them
GEOCODER=census

# Email (Phase 7): "mailbox" keeps every email in the database for the practice mailbox page
# (http://localhost:3000/dev/mailbox) and sends nothing. The live site uses EMAIL_TRANSPORT=resend,
# which needs Resend's API key:
# RESEND_API_KEY=re_...
EMAIL_TRANSPORT=mailbox
EMAIL_FROM="Neighbors Kitchen <no-reply@neighborskitchen.test>"

# How often (in milliseconds) the background helper sends emails and runs timed tasks
JOBS_INTERVAL_MS=5000

# Minutes after an order is completed before the rate-your-meal reminder
# (120 on the live site; 2 here so it can be tried quickly)
RATE_REMINDER_DELAY_MINUTES=2

# Live site (Phase 8a). Keep these values on this computer.
# PREVIEW_MODE=true shows the preview banner, keeps search engines out and allows the sample data.
PREVIEW_MODE=false
# Proxies in front of the app: 1 on Railway, 0 here
TRUST_PROXY_HOPS=0
# Password of the sample accounts on the preview site (Password123 when not set):
# DEMO_PASSWORD=...

# ---------------------------------------------------------------------------
# Added in later phases (not used yet)
# ---------------------------------------------------------------------------

# Stripe payments, test mode (Phase 5)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PLATFORM_FEE_PERCENTAGE=10
